  - name: "\u840E\u9761"
    description: "\u5982\u679C\u5BF9\u8C61\u5F53\u524D\u7684\u529B\u91CF\n\u4E0D\u4F4E\u4E8E\u521D\u59CB\u529B\u91CF\u76845%\n\uFF0C\u5219\u4F7F\u5BF9\u8C61\u964D\u4F4E10%\n\u7684\u529B\u91CF\uFF0C\u6700\u9AD8\u4E0D\u8D85\u8FC7\n6\u70B9\u529B\u91CF\uFF0C\u6301\u7EED16s"
    buffPrefab: {fileID: 6051908474743900384, guid: 5fd193f1655dc7743a42ceb0c0f06c35, type: 3}
  - name: "\u8106\u5F31"
    description: "\u5982\u679C\u5BF9\u8C61\u5F53\u524D\u7684\u97E7\u6027\n\u4E0D\u4F4E\u4E8E\u521D\u59CB\u97E7\u6027\u76845%\n,\u4F7F\u5BF9\u8C61\u964D\u4F4E10%\u7684\u97E7\n\u6027\uFF0C\u6700\u9AD8\u4E0D\u8D85\u8FC720\u70B9\n\u97E7\u6027\uFF0C\u6301\u7EED16s"
    buffPrefab: {fileID: 6051908474743900384, guid: cead13d5fae505448b7f5f0895671e14, type: 3}
  - name: "\u8FDF\u7F13"
    description: "\u4F7F\u5BF9\u8C61\u964D\u4F4E10%\u901F\u5EA6\n\uFF0C\u6301\u7EED16s"
    buffPrefab: {fileID: 6051908474743900384, guid: 886db31d52d2c0f48881a24c299d83a5, type: 3}
  - name: "\u51DD\u91CD"
    description: "\u4F7F\u5BF9\u8C61\u964D\u4F4E10%\u8D77\u8DF3\n\u901F\u5EA6\uFF0C\u6301\u7EED16s"
    buffPrefab: {fileID: 6051908474743900384, guid: bad8008b88feeba4cb5cc52fec226acd, type: 3}
  - name: "\u707C\u4F24"
    description: "\u4F7F\u5BF9\u8C61\u6BCF0.1\u79D2\u6263\u9664\n0.05\u6EF4\u8840\uFF0C\u6301\u7EED6s\uFF0C\nbuff\u6301\u7EED\u671F\u95F4\u5982\u679C\u88AB\n\u65BD\u52A0\u65B0\u7684\u707C\u4F24\u5219\u6301\u7EED\n\u65F6\u95F4\u5EF6\u957F6s"
