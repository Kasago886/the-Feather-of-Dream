  - name: "\u4F24\u75D5\u62B5\u6297"
    description: "\u4F7F\u5BF9\u8C61\u63D0\u9AD81\u70B9\u4F24\u75D5\n\u6297\u6027\uFF0C\u6301\u7EED16s"
    buffPrefab: {fileID: 6051908474743900384, guid: 0496f46b86d19524a8dc5e3a93eaf4cb, type: 3}
  - name: "\u4F24\u75D5\u8106\u5F31"
    description: "\u4F7F\u5BF9\u8C61\u964D\u4F4E1\u70B9\u4F24\u75D5\n\u6297\u6027\uFF0C\u6301\u7EED16s"
    buffPrefab: {fileID: 6051908474743900384, guid: 7f909f8d3cd163c489f3a6455724648d, type: 3}
  - name: "\u88C2\u9699"
    description: "\u4F7F\u5BF9\u8C61\u5728n\u6B21\u53D7\u51FB\u540E\uFF0C\n\u53D7\u5230n*\u4F24\u75D5\u5C42\u6570*\u4F24\n\u75D5\u4F24\u5BB3*\u8BEF\u89E3\u7EA7\u6570\u7684\u4F24\n\u5BB3\uFF0C\u6301\u7EED\u65F6\u95F4\u65E0\u9650\u81F3\n\u53D1\u6325\u4F5C\u7528"
    buffPrefab: {fileID: 6051908474743900384, guid: e89c2858047c78e478350ea280492e0b, type: 3}
  - name: "\u632F\u594B+"
    description: "\u4F7F\u5BF9\u8C61\u589E\u52A010%\u7684\u529B\u91CF\uFF0C\n\u6301\u7EED\u81F3\u4E0B\u6B21\u653B\u51FB"
    buffPrefab: {fileID: 6051908474743900384, guid: e9689e698a6fc984daf2b89393b7ca4e, type: 3}
  - name: "\u94C1\u5FC3"
    description: "\u97E7\u6027\u589E\u52A050\uFF0C\u6301\u7EED10s"
    buffPrefab: {fileID: 6051908474743900384, guid: 8d713639ba375f8489aff36c0b707dd9, type: 3}
  - name: "\u62A4\u76FE"
    description: "\u83B7\u5F97\u8840\u91CF20\uFF0C\u6301\u7EED10s\n\u7684\u62A4\u76FE"
    buffPrefab: {fileID: 6051908474743900384, guid: 6ee2aab630ddf0a4882bf9536589276c, type: 3}
  - name: "\u91CA\u7136"
    description: "\u5982\u679C\u5BF9\u8C61\u7684\u97E7\u6027\u4E3A\u6B63\u65F6\uFF0C\n\u5C06\u5BF9\u8C61\u7684\u97E7\u6027/10\u8F6C\u6362\n\u4E3A\u529B\u91CF\uFF0C\u6301\u7EED60s(\u6CE8\u610F\n\uFF1A\u4F7F\u7528\u4E4B\u540E\u97E7\u6027\u5F52\u96F6)\uFF0C\n\u5982\u679C\u97E7\u6027\u4E3A\u4E0D\u4E3A\u6B63\u65F6\u5219\n+10\u97E7\u6027"
    buffPrefab: {fileID: 6051908474743900384, guid: 52c1af88f0f333c4db3cf8c5513c70b2, type: 3}
  - name: "\u60CA\u60F6"
    description: "\u5728\u6709\u7FBD\u89E3\u9501\u7684\u6761\u4EF6\u4E0B\uFF0C\n\u7ACB\u5373\u53D7\u52301\u70B9\u4F24\u5BB3\uFF0C\u5E76\n\u56DE\u590D1\u6EF4\u8840\uFF0C\u73A9\u5BB6\u548C\u654C\n\u4EBA\u901A\u7528"
    buffPrefab: {fileID: 6051908474743900384, guid: d63b692caa7a3d44bafa99514c760239, type: 3}
  - name: "\u8BEF\u89E3"
    description: "\u589E\u5F3A\u201C\u4F24\u75D5\u201D\uFF0C\u6301\u7EED\u65F6\u95F4\u65E0\u9650\uFF0C\n\u53EA\u80FD\u67091\u5C42\uFF0C\u91CD\u590D\u83B7\u5F97\u201C\u8BEF\u89E3\u201D\n\u53EF\u4EE5\u63D0\u9AD8\u5176\u7B49\u7EA7\r\n1\u7EA7\uFF1A\u589E\u52A01\u70B9\u201C\u4F24\u75D5\u201D\u4F24\u5BB3 
      \n2\u7EA7\uFF1A\u589E\u52A02\u70B9\u201C\u4F24\u75D5\u201D\u4F24\u5BB3\uFF0C\n\u5E76\u964D\u4F4E20\u70B9\u5F02\u5E38\u62B5\u6297 
      \n3\u7EA7\uFF1A\u589E\u52A02\u70B9\u201C\u4F24\u75D5\u201D\u4F24\u5BB3\uFF0C\n\u5E76\u5728\u964D\u4F4E20\u70B9\u5F02\u5E38\u62B5\u6297\u7684\u57FA\n\u7840\u4E0A\u964D\u4F4E10%\u7684\r                        
      \u5F02\u5E38\u62B5\u6297\u5E76\n\u964D\u4F4E3\u70B9\u4F24\u75D5\u62B5\u6297"
    buffPrefab: {fileID: 6051908474743900384, guid: 90947bb49483401459dcf8b874a63432, type: 3}
  - name: "\u5012\u65BD"
    description: "\u4F7F\u5BF9\u8C61\u4E0B\u4E00\u6B21\u653B\u51FB\n\u9644\u5E261\u5C42\u201C\u4F24\u75D5\u201D"
    buffPrefab: {fileID: 6051908474743900384, guid: 7523f4c629c940140b25aa32a0279414, type: 3}
  - name: "\u4E0D\u7A33\u5B9A\u7A81\u53D8"
    description: "\u4F7F\u5BF9\u8C61\u6839\u636E\u81EA\u8EAB\u5F02\u5E38\u6297\u6027\u968F\n\u673A\u83B7\u5F97\u529B\u91CF\u548C\u97E7\u6027\u6548\u679C\uFF0C\u6301\n\u7EED10s"
    buffPrefab: {fileID: 6051908474743900384, guid: ff981ebf3a490e84eb45ac1a4d6b7001, type: 3}
  - name: "\u68A6\u5D29"
    description: "\u4F7F\u81EA\u8EAB\u653B\u51FB\u901F\u5EA6+400%\uFF0C\n\u6301\u7EED1s"
    buffPrefab: {fileID: 6051908474743900384, guid: 07dfdafef8a3b8347a98231f63645c46, type: 3}
  - name: "\u68A6\u8EAB"
    description: "\u84C4\u529B2s\uFF0C\u83B7\u5F9710s20\u70B9\u62A4\u76FE\n\uFF0C\u88AB\u4EFB\u610F\u653B\u51FB\u6253\u65AD\u540E\u4E3A\u73A9\u5BB6\n\u6DFB\u52A0\u62A4\u76FE"
    buffPrefab: {fileID: 6051908474743900384, guid: eb97e4e3bb60b4e46b1484441e4c0bcf, type: 3}
  - name: "\u68A6\u7F20"
    description: "\u6301\u7EED5s\uFF0C\u73A9\u5BB6\u6BCF\u6B21\u4F7F\u7528\u51B2\u523A\n\u4F7F\u81EA\u8EAB\u901F\u5EA6-10%\uFF0C\u6301\u7EED2s"
    buffPrefab: {fileID: 6051908474743900384, guid: b432e22325e3771499d8e29f8f5eb95a, type: 3}
  - name: "\u5DE7\u624B"
    description: "\u4F7F\u73A9\u5BB6\u83B7\u53D6\u5361\u724C\u51B7\u5374-20%"
    buffPrefab: {fileID: 6051908474743900384, guid: c969fd7866ecf284f8348a4c665fefd6, type: 3}
  - name: "\u88C2\u9699\u2164"
    description: "\u4F7F\u5BF9\u8C61\u5728n\u6B21\u53D7\u51FB\u540E\uFF0C\n\u53D7\u5230n*\u4F24\u75D5\u5C42\u6570\u7684\u4F24\n\u5BB3\uFF0C\u6301\u7EED\u65F6\u95F4\u65E0\u9650\u81F3\n\u53D1\u6325\u4F5C\u7528"
    buffPrefab: {fileID: 6051908474743900384, guid: e89c2858047c78e478350ea280492e0b, type: 3}
  - name: "\u68A6\u6E90"
    description: "\u6301\u7EED10s,\u4F7F\u73A9\u5BB6\u529B\u91CF\n+5\uFF0C\u97E7\u6027+5\uFF0C\u5F53\u518D\u6B21\n\u83B7\u5F97\u68A6\u6E90\u65F6\u6301\u7EED\u65F6\u95F4\n\u91CD\u7F6E"
    buffPrefab: {fileID: 6051908474743900384, guid: 5f2a0f20d35a59f46b02cfe60d16726d, type: 3}
  - name: "\u51DD\u68A6"
    description: "\u4F7F\u81EA\u8EAB\u901F\u5EA6\u4E0E\u8DF3\u8DC3\u901F\n\u5EA6-80%\uFF0C\u6BCF0.5s\u83B7\n\u5F97\u4E00\u6B21\u68A6\u6E90\uFF0C\u6700\u591A5s\uFF0C\n\u88AB\u653B\u51FB\u6216\u51B2\u523A\u63D0\u524D\u7ED3\n\u675Fbuff"
    buffPrefab: {fileID: 6051908474743900384, guid: 7f89299a9dd82a04f99e00e193d05ff1, type: 3}
  - name: "\u51DD\u805A"
    description: "\u4F7F\u81EA\u8EAB\u901F\u5EA6\u964D\u4F4E80%\uFF0C\n\u97E7\u6027-40\uFF0C\u6301\u7EED3\u79D2\u540E\n\u83B7\u5F97\u5174\u594B"
    buffPrefab: {fileID: 6051908474743900384, guid: 7f89299a9dd82a04f99e00e193d05ff1, type: 3}
  - name: "\u5174\u594B"
    description: "\u83B7\u5F9750\u70B9\u529B\u91CF\uFF0C\u6301\u7EED\n10s"
    buffPrefab: {fileID: 6051908474743900384, guid: 7f89299a9dd82a04f99e00e193d05ff1, type: 3}
  - name: "\u7834\u7ACB"
    description: "\u83B7\u5F97\u201C\u7834\u7ACB\u201D0.5s\uFF0C\u82E5\n\u6B64\u671F\u95F4\u88AB\u653B\u51FB\uFF0C\u83B7\u5F97\n\u201C\u5174\u594B\u201D"
    buffPrefab: {fileID: 6051908474743900384, guid: 7f89299a9dd82a04f99e00e193d05ff1, type: 3}
  - name: "\u4E2D\u6BD2"
    description: "\u4F7F\u5BF9\u8C61\u6BCF\u79D2\u6263\u9664\n5\u6EF4\u8840\uFF0C\u6301\u7EED5s"
    buffPrefab: {fileID: 6051908474743900384, guid: 09237f85dd5f9a74e98d377bfb8e8cc3, type: 3}
  - name: "\u6B63\u4E49"
    description: "\u4F7F\u73A9\u5BB6\u4E0B\u4E00\u5F20\u653B\n\u51FB\u5361\u653B\u51FB\u529B\u7FFB\u500D"
    buffPrefab: {fileID: 6051908474743900384, guid: 64dc9256298922345b15ee2e88aee0b2, type: 3}
