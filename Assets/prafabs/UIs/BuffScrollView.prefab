    buffPrefab: {fileID: 6051908474743900384, guid: 2d04db0d9687b9748b8398f3b029931a, type: 3}
  - name: "\u8F7B\u5065"
    description: "\u4F7F\u5BF9\u8C61\u52A010%\u8D77\u8DF3\u901F\n\u5EA6\uFF0C\u6301\u7EED16s"
    buffPrefab: {fileID: 6051908474743900384, guid: 155259d1d9f73c547ba6ffb8053831a0, type: 3}
  - name: "\u575A\u5B9A"
    description: "\u4F7F\u73A9\u5BB6\u7684\u83B7\u5F97\u5361\u724C\u7684\n\u65F6\u95F4\u95F4\u9694\u51CF\u5C111\u79D2\uFF0C\n\u4F7F\u654C\u4EBA\u4F7F\u7528\u653B\u51FB\u724C\u7684\n\u95F4\u9694\u51CF\u5C111\u79D2\uFF0C\u6301\u7EED\n12\u79D2"
    buffPrefab: {fileID: 6051908474743900384, guid: fcbfb5020b599ba46b0c6604e1339194, type: 3}
  - name: "\u5353\u8D8A"
    description: "\u4F7F\u73A9\u5BB6\u589E\u52A0\u4E00\u4E2A\u5361\u69FD\n\uFF0C\u4F7F\u654C\u4EBA\u7684\u6548\u679C\u724C\u4F7F\n\u7528\u65F6\u95F4\u95F4\u9694-3s\uFF0C\u6301\n\u7EED1\u5206\u949F"
