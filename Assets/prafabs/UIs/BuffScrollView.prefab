    buffPrefab: {fileID: 6051908474743900384, guid: 4a05273740a7e134ea633ca91714987c, type: 3}
  - name: "\u632F\u594B"
    description: "\u4F7F\u5BF9\u8C61\u589E\u52A010%\u7684\u529B\n\u91CF\uFF0C\u6700\u9AD8\u4E0D\u8D85\u8FC76\u70B9\n\u529B\u91CF\uFF0C\u6301\u7EED16s"
