  buffImformation:
  - name: "\u4F24\u75D5"
    description: "\u5728\u6709\u7FBD\u89E3\u9501\u7684\u6761\u4EF6\u4E0B\n\uFF0C\u53D7\u5230\u4E0D\u4F4E\u4E8E1\u70B9\u4F24\n\u5BB3\u540E\u6263\u96641\u6EF4\u8840\uFF0C\u5E76\n\u67091/3\u7684\u6982\u7387\u89E3\u9664\u8BE5\nbuff"
    buffPrefab: {fileID: 6051908474743900384, guid: 209ae3ea1d3ec704b879f597596c73a5, type: 3}
  - name: "\u5FE7\u90C1"
    description: "\u4F7F\u73A9\u5BB6\u7684\u83B7\u5F97\u5361\u724C\u7684\n\u65F6\u95F4\u95F4\u9694\u589E\u52A01\u79D2\uFF0C\n\u4F7F\u654C\u4EBA\u4F7F\u7528\u653B\u51FB\u724C\u7684\n\u95F4\u9694\u589E\u52A01\u79D2\uFF0C\u6301\u7EED\n12\u79D2"
    buffPrefab: {fileID: 6051908474743900384, guid: 10c723a59fb9fce4c996866fba69fd9f, type: 3}
  - name: "\u5D29\u6E83"
    description: "\u4F7F\u73A9\u5BB6\u6216\u654C\u4EBA\u7684\u529B\u91CF\n\u548C\u97E7\u6027\u964D\u4F4E\u521D\u59CB\u6700\u521D\n\u529B\u91CF\u548C\u97E7\u6027\u768410%\uFF0C\n\u6301\u7EED13\u79D2"
    buffPrefab: {fileID: 6051908474743900384, guid: b54bb48b869d7934cb495dd4aea0d48f, type: 3}
  - name: "\u51E1\u5EB8"
    description: "\u4F7F\u73A9\u5BB6\u51CF\u5C11\u4E00\u4E2A\u5361\u69FD\n\uFF0C\u4F7F\u654C\u4EBA\u7684\u6548\u679C\u724C\u4F7F\n\u7528\u65F6\u95F4\u95F4\u9694+3s\uFF0C\u6301\n\u7EED1\u5206\u949F"
    buffPrefab: {fileID: 6051908474743900384, guid: f40d0476d70158b4db5623bd5a23d6d3, type: 3}
  - name: "\u624D\u534E"
    description: "\u4F7F\u5BF9\u8C61\u97E7\u6027\u4E585\uFF0C\u6301\n\u7EED29.7s"
    buffPrefab: {fileID: 6051908474743900384, guid: 5cc852aacef6ee04487e6391832b4636, type: 3}
  - name: "\u535A\u5B66"
    description: "\u4F7F\u5BF9\u8C61\u529B\u91CF\u4E582\uFF0C\u6301\n\u7EED29.7s"
