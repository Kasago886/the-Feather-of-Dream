  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7b89917c83f8ade41a5d07e173ab0503, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemName: Dr.Nepriz
  information: "\u4E00\u9636\u6BB5\uFF1A\n\u5929\u624D\uFF0C\u4ED6\u5411\u6765\u4EE5\u6B64\u81EA\u8C13\uFF0C\u53EF\u5728\u8FD9\u904D\u5730\u51E1\u5EB8\u7684\u5927\u5730\u4E0A\u5374\u65E0\u4EBA\u8D4F\u8BC6\u4ED6\u7684\u624D\u534E\n\u4ED6\u5B66\u5BCC\u4E94\u8F66\uFF0C\u53EF\u8FD9\u4E3E\u4E16\u7684\u611A\u8005\u5374\u4ECE\u672A\u8BA4\u53EF\u4ED6\u7684\u535A\u5B66\n\u4ED6\u8981\u8BA9\u90A3\u4E9B\u8F7B\u89C6\u4ED6\u7684\u4EBA\u77E5\u9053\uFF0C\u8C01\u4EBA\u624D\u53EF\u627F\u90A3\u5929\u624D\u7684\u6842\u51A0\n\u4ED6\u4E0D\u5C51\u4E8E\u751F\u547D\u4F26\u7406\uFF0C\u4ED6\u4E0D\u6B62\u4E8E\u7EB2\u5E38\u9053\u5FB7\n\u4ED6\u5411\u524D\u8FC8\u8FDB\uFF0C\u4E0D\u62E9\u624B\u6BB5\n\u4ED6\u820D\u5F03\u4E86\u53CB\u60C5\uFF0C\u820D\u5F03\u4E86\u5BB6\u5EAD\n\u751A\u81F3...\u4ED6\u7684\u540D\u5B57\n\n\u6212\u611A\u8005\uFF1A\n\u8FDC\u7A0B\u653B\u51FB
    \u653B\u51FB\u529B\u4E3A5\n\n\u60E9\u5EB8\u8005\uFF1A\n\u6FC0\u5149 \u653B\u51FB\u529B\u4E3A8
    \u4E3A\u73A9\u5BB6\u65BD\u52A01\u5C42\u201D\u51E1\u5EB8\u201C\u4E0E5\u5C42\u201D\u968F\u673ABuff\u201C\n\n\u770B\uFF01\u53C8\u4E00\u4E2A\uFF1A\n\u53EC\u5524\u201C\u60E9\u5EB8\u8005\u201D\uFF0C\u5E76\u4E3A\u73A9\u5BB6\u65BD\u52A04\u5C42\u201C\u8FDF\u7F13\u201D\n\n\u6211\u81EA\u624D\u534E\u6A2A\u6EA2\uFF1A\n\u4E3A\u81EA\u5DF1\u65BD\u52A0\u201C\u624D\u534E\u201D\u5E76\u5BF9\u73A9\u5BB6\u65BD\u52A0\u201C\u840E\u9761\u201D\n\n\u6211\u81EA\u535A\u5B66\u591A\u624D\uFF1A\n\u4E3A\u81EA\u5DF1\u65BD\u52A0\u201C\u535A\u5B66\u201D\u5E76\u5BF9\u73A9\u5BB6\u65BD\u52A0\u201C\u8106\u5F31\u201D\n\n\u7686\u4E3A\u51E1\u5EB8\uFF1A\n\u4F7F\u4E0B\u4E00\u6B21\u653B\u51FB\u4E3A\u73A9\u5BB6\u6DFB\u52A01\u5C42\u201C\u51E1\u5EB8\u201D\uFF0C\u5E76\u7ACB\u5373\u4E3A\u73A9\u5BB6\u6DFB\u52A02\u5C42\u201C\u8106\u5F31\u201D\n\u4E0E\u201C\u840E\u9761\u201D\n\n\u4E3E\u4E16\u5EB8\u624D\uFF1A\n\u6240\u6709\u53D7\u5230\u7684\u8D1F\u9762buff\u90FD\u5C06\u88AB\u8F6C\u5316\u4E3A\"\u4E0D\u88AB\u8BA4\u53EF\"\uFF0C\u4E0A\u965099\u5C42\n\n\u4E8C\u9636\u6BB5\uFF1A\n\u5426\u8BA4\uFF0C\u5426\u8BA4\u4E00\u5207\u5916\u754C\u7684\u8BC4\u4EF7\n\u4E3A\u81EA\u5DF1\u4F5C\u8327\n\u4E00\u8DEF\u8D70\u6765\uFF0C\u7A76\u7ADF\u83B7\u5F97\u4E86\u4EC0\u4E48\uFF1F\n\u53EA\u6709\u624B\u4E0A\u7684\u9C9C\u8840\uFF0C\u4E0E\u90A3\u4E9B\u4F5C\u5455\u7684\u602A\u7269\n\u5728\u4E00\u5207\u7684\u6700\u540E\u8BF7\u8BA9\u6211\u62FE\u8D77\u6211\u90A3\u6700\u540E\u6709\u6743\u62FE\u8D77\u4E4B\u7269\n\u6211\u90A3\u820D\u5F03\u4E4B\u7269\n\u201C\u6D85\u666E\u91CC\u5179\u7EB3\xB7\u8C22\u5C14\u76D6\u8036\u7EF4\u5947\xB7\u6C83\u5C14\u5B54\u65AF\u57FA\u201D\u3001\n\n\u6212\u611A\u8005\uFF1A\n\u8FDC\u7A0B\u653B\u51FB
    \u653B\u51FB\u529B\u4E3A5\n\n\u60E9\u5EB8\u8005\uFF1A\n\u6FC0\u5149 \u653B\u51FB\u529B\u4E3A8
    \u4E3A\u73A9\u5BB6\u65BD\u52A01\u5C42\u201D\u51E1\u5EB8\u201C\u4E0E5\u5C42\u201D\u968F\u673ABuff\u201C\n\n\u770B\uFF01\u53C8\u4E00\u4E2A\uFF1A\n\u53EC\u5524\u201C\u60E9\u5EB8\u8005\u201D\uFF0C\u5E76\u4E3A\u73A9\u5BB6\u65BD\u52A04\u5C42\u201C\u8FDF\u7F13\u201D\n\n\u6211\u81EA\u624D\u534E...\uFF1A\n\u4E3A\u81EA\u5DF1\u65BD\u52A02\u5C42\u201C\u624D\u534E\u201D\u5E76\u5BF9\u73A9\u5BB6\u548C\u81EA\u5DF1\u65BD\u52A02\u5C42\u201C\u840E\u9761\u201D\n\n\u6211\u81EA\u535A\u5B66...\uFF1A\n\u4E3A\u81EA\u5DF1\u65BD\u52A02\u5C42\u201C\u535A\u5B66\u201D\u5E76\u5BF9\u73A9\u5BB6\u548C\u81EA\u5DF1\u65BD\u52A02\u5C42\u201C\u8106\u5F31\u201D\n\n\u4E0D\u8FC7\u51E1\u5EB8\uFF01\uFF01\uFF01\uFF1A\n\u4F7F\u4E0B\u4E00\u6B21\u653B\u51FB\u4E3A\u73A9\u5BB6\u6DFB\u52A03\u5C42\u201C\u51E1\u5EB8\u201D\uFF0C\u5E76\u7ACB\u5373\u4E3A\u73A9\u5BB6\u6DFB\u52A02\u5C42\u201C\u8106\u5F31\u201D\u4E0E\u201C\u840E\u9761\u201D\n\n\u53EF\u60B2\u7684\u6B8B\u6B21\u54C1\uFF01\uFF1A\n\u4E3A\u73A9\u5BB6\u6DFB\u52A01\u5C42\u201C\u7455\u75B5\u4E4B\u4F5C\u201D\u5E76\u4E3A\u81EA\u8EAB\u65BD\u52A010\u5C42\u201C\u51E1\u5EB8\u201D\n\n\u8BA4\u540C\u6211\uFF01\uFF01\uFF01\uFF1A\n\u4E3A\u81EA\u8EAB\u65BD\u52A02\u5C42\u201C\u81EA\u6211\u6B3A\u9A97\u201D\u4E3A\u73A9\u5BB6\u4E0E\u81EA\u8EAB\u65BD\u52A01\u5C42\u201C\u51E1\u5EB8\u201D\n\n\u6211...\u4EA6\u662F\u51E1\u5EB8\uFF1A\n\u4EE4\u81EA\u8EAB\u5728\u573A\u65F6\u4EE4\u6240\u6709\u201D\u51E1\u5EB8\u201C\u7684\u6301\u7EED\u65F6\u95F4\u53D8\u4E3A\u65E0\u9650\uFF0C\u5E76\u4E14\u4EE4\u5176\u53EF\u901A\u8FC7\u653B\u51FB\u5728\n\u73A9\u5BB6\u4E0E\u81EA\u8EAB\u4E4B\u95F4\u8F6C\u79FB\n\n\u6211\u5C31\u662F\u5EB8\u624D\uFF1A\n\u6BCF\u53D7\u5230\u81EA\u8EAB\u6700\u5927\u751F\u547D\u503C20%\u7684\u4F24\u5BB3\u540E\uFF0C\u4EE4\u81EA\u8EAB\u6240\u6709\u201C\u51E1\u5EB8\u201D\u8F6C\u5316\u4E3A\u201C\u6E34\u6C42\u8BA4\u53EF\u201D"
