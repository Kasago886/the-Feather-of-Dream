  m_Name: 
  m_EditorClassIdentifier: 
  itemName: "\u7740\u706B\u7684\u6863\u6848"
  information: "\u5386\u53F2\uFF0C\u771F\u76F8\uFF0C\u5C82\u53EF\u5982\u6B64\u4ED8\u4E4B\u4E00\u70AC\uFF1F\n\n\u56DB\u5904\u98DE\u821E\u7684\u70C8\u7130\uFF1A\n\u653B\u51FB\u529B0\n\n\u63A9\u76D6\u4E00\u5207\u7684\u70C8\u7130\uFF1A\n\u4E3A\u81EA\u8EAB\u65BD\u52A02\u5C42\"\u707C\u4F24\"\n\u707C\u4F24\uFF1A\u4F7F\u5BF9\u8C61\u6BCF0.1\u79D2\u6263\u96640.1\u6EF4\u8840\uFF0C\u6301\u7EED6s\uFF0Cbuff\u6301\u7EED\u671F\u95F4\u5982\u679C\u88AB\u65BD\u52A0\u65B0\u7684\u707C\u4F24\u5219\u6301\u7EED\u65F6\u95F4\u5EF6\u957F6s\n\n\u4E0D\u7518\u6D88\u901D\u7684\u62B5\u6297\uFF1A\n\u4E3A\u81EA\u8EAB\u63D0\u9AD8100\u70B9\u5F02\u5E38\u6297\u6027\u4E0E5\u70B9\u707C\u4F24\u6297\u6027\n\n\u6587\u660E\u4E0B\u9650\u7684\u7F6A\u8BC1\uFF1A\n\u4E3A\u73A9\u5BB6\u65BD\u52A01\u5C42\u201C\u707C\u4F24\u8106\u5F31\u201D\uFF0C\u5E76\u4E3A\u73A9\u5BB6\u65BD\u52A01\u5C42\u201C\u707C\u4F24\u201D\n\n\u65E0\u6CD5\u63A9\u9970\u7684\u771F\u76F8\uFF1A\n\u4E3A\u73A9\u5BB6\u65BD\u52A04\u5C42\u201C\u707C\u4F24\u201D\n\n\u63ED\u793A\u4E00\u5207\uFF08\u4EA1\u8BED\uFF09\uFF1A\n\u4EE4\u73A9\u5BB6\u83B7\u5F976\u5C42\u968F\u673Abuff"
