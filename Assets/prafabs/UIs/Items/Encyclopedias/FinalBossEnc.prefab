  m_Name: 
  m_EditorClassIdentifier: 
  itemName: "\u5C0F\u68A6"
  information: "\u90FDBoss\u6218\u4E86\u4F60\u8FD8\u6709\u95F2\u5FC3\u770B\u56FE\u9274\uFF1F\uFF1F\uFF1F\n\n\u827E\u8389\u662F\u4E00\u4E2A\u5C0F\u5973\u5B69\uFF0C\u5979\u610F\u5916\u6B7B\u4EA1\u540E\uFF0C\u5979\u7684\u7236\u4EB2\u5F17\u5170\u514B\u5E0C\u671B\u901A\u8FC7\u79D1\u5B66\u6280\u672F\u590D\u6D3B\u5979\uFF0C\u56E0\u6B64\u521B\u9020\u4E86\u4EBA\u5F62\u673A\u5668\u4EBA\u5C0F\u68A6\uFF0C\u5E76\u8D4B\u4E88\u5979\u827E\u8389\u7684\u8BB0\u5FC6\u4E0E\u60C5\u611F\u3002\u7136\u800C\uFF0C\u5F17\u5170\u514B\u59CB\u7EC8\u65E0\u6CD5\u63A5\u7EB3\u7531\u673A\u68B0\u6784\u6210\u7684\u5C0F\u68A6\uFF0C\u4E8E\u662F\u4ED6\u5C06\u76EE\u5149\u8F6C\u5411\u4E86\u751F\u7269\u6280\u672F\uFF0C\u671F\u671B\u901A\u8FC7\u827E\u8389\u7684\u514B\u9686\u4F53\u590D\u6D3B\u827E\u8389\u3002\u7136\u800C\u610F\u5916\u53D1\u751F\u4E86\uFF0C\u4E00\u4E2A\u514B\u9686\u4F53\u6253\u7834\u4E86\u5B9E\u9A8C\u50A8\u7F50\uFF0C\u91CA\u653E\u51FA\u540D\u4E3A\u201C\u68A6\u201D\u7684\u5371\u9669\u7269\u8D28\uFF0C\u5BFC\u81F4\u6574\u4E2A\u8BBE\u65BD\u7684\u4EBA\u7C7B\u5168\u90E8\u4E27\u751F\u3002\r\n\u5C0F\u68A6\u4F5C\u4E3A\u552F\u4E00\u7684\u5E78\u5B58\u8005\uFF0C\u63A5\u7BA1\u4E86\u6574\u4E2A\u8BBE\u65BD\u7684\u8FD0\u4F5C\uFF0C\u7EE7\u7EED\u7740\u514B\u9686\u4EBA\u5B9E\u9A8C\u3002\u5979\u5E0C\u5180\u7740\u5229\u7528\u514B\u9686\u4F53\u6765\u6536\u96C6\u6563\u843D\u7684\u7FBD\u2014\u2014\u4E00\u79CD\u85CF\u4E8E\u7075\u9B42\u6DF1\u5904\u7684\u7269\u8D28\uFF0C\u6700\u7EC8\u501F\u7528\u68A6\u548C\u7FBD\u7684\u529B\u91CF\u6210\u4E3A\u4EBA\u7C7B\u3002\u4E3A\u6B64\uFF0C\u5C0F\u68A6\u5728\u514B\u9686\u4F53\u8111\u4E2D\u690D\u5165\u4E86\u82AF\u7247\uFF0C\u8BA9\u5176\u8BA4\u4E3A\u81EA\u5DF1\u662F\u4E00\u4F4D\u73A9\u5BB6\uFF0C\u4ECE\u800C\u5FC3\u7518\u60C5\u613F\u5730\u63A2\u7D22\u8BBE\u65BD\uFF0C\u6536\u96C6\u7FBD\u7FFC\u3002\r\n"
