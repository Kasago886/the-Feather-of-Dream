  m_Name: 
  m_EditorClassIdentifier: 
  itemName: "\u4E0D\u88AB\u8BA4\u53EF\u4E4B\u7FBD"
  information: "\u771F\u6B63\u4EE4\u6211\u5760\u5165\u6DF1\u6E0A\u7684\uFF0C\u4ECE\u4E0D\u662F\u4ED6\u4EBA\u7684\u8BC4\u4EF7\uFF0C\u800C\u662F\u81EA\u5DF1\u7684\u5FC3\u9B54\n\n\u97E7\u6027+30   
    \u529B\u91CF+20    \u5F02\u5E38\u6297\u6027+10    \u5361\u724C\u69FD\u4F4D+1   
    \n\u83B7\u5F97\u88AB\u52A8\u201C\u6392\u4ED6\u201D\n\u53EC\u5524\u201C\u60E9\u611A\u8005\u201D\uFF0C\u6BCF\u9694\u4E00\u6BB5\u65F6\u95F4\u5BF9\u654C\u4EBA\u9020\u6210\u4E00\u5B9A\u4F24\u5BB3\u5E76\u65BD\u52A0\n2\u5C42\u201C\u8106\u5F31\u201D\n\u83B7\u5F97\u88AB\u52A8\u201C\u5FC3\u9632\u201D\n\u6BCF\u9694\u4E00\u6BB5\u65F6\u95F4\u83B7\u5F97\u4E0E\u8BE5\u65F6\u95F4\u6BB5\u5185\u6240\u53D7\u4F24\u5BB3\u4EE5\u53CA\u81EA\u8EAB\u7684\u8D1F\u9762\nBuff\u4E2A\u6570\u5448\u6BD4\u4F8B\u7684\u62A4\u76FE\n\u83B7\u5F97\u88AB\u52A8\u201C\u81EA\u6270\u201D\n\u6BCF\u9694\u4E00\u6BB5\u65F6\u95F4\u83B7\u5F973\u4E2A\u968F\u673ABuff\uFF0C\u5982\u679CBuff\u4E3A\u8D1F\u9762Buff\u5219\u518D\n\u83B7\u5F971\u4E2A\u968F\u673ABuff\n\n\u5361\u724C\uFF1A\n\u9009\u9898\u5B9A\u5411   
    \u6587\u732E\u56DE\u987E    \u8BBE\u8BA1\u89C4\u5212    \u83B7\u53D6\u6279\u51C6   
    \u6536\u96C6\u6570\u636E\n\u6570\u636E\u5206\u6790    \u5F97\u51FA\u7ED3\u8BBA   
    \u64B0\u5199\u62A5\u544A    \u53D1\u8868\u5206\u4EAB\n"
