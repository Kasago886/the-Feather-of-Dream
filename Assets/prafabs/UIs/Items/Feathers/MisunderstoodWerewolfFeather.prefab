  m_Name: 
  m_EditorClassIdentifier: 
  itemName: "\u50B2\u6162\u504F\u89C1\u4E4B\u7FBD"
  information: "\u6211\u4EEC\u90FD\u7EDD\u671B\u7684\u56F0\u5728\u8FD9\u540D\u4E3A\u201C\u504F\u89C1\u201D\u7684\u76D1\u7262\u91CC\n\n\u97E7\u6027+10   
    \u529B\u91CF+15    \u5F02\u5E38\u6297\u6027+20    \u4F24\u75D5\u6297\u6027+4\n\u83B7\u5F97\u88AB\u52A8\u201C\u751F\u800C\u4E3A\u72FC\u201D\n\u4F7F\u81EA\u8EAB\u83B7\u5F971\u5C42\u201C\u8BEF\u89E3\u201D\uFF0C\u653B\u51FB\u5C06\u9644\u5E261\u5C42\u201C\u4F24\u75D5\u201D\u5E76\u524A\u51CF\u76EE\u68071\u70B9\u5F02\u5E38\n\u6297\u6027 
    \n\u83B7\u5F97\u88AB\u52A8\u201C\u5FE7\u90C1\u521B\u4F24\u201D\n\u81EA\u8EAB\u6BCF\u62E5\u67091\u5C42\u201C\u4F24\u75D5\u201D\u4FBF\u52A01\u70B9\u5F02\u5E38\u6297\u6027\u4E0E\u97E7\u6027\uFF0C\u82E5\u65E0\u201C\u4F24\u75D5\u201D\n\u4FBF\u52A05\u529B\u91CF\n\u83B7\u5F97\u88AB\u52A8\u201C\u65E0\u8F9C\u8005\u201D\n\u5F53\u5B58\u5728\u88AB\u89E3\u9501\u7684\u7FBD\u7684\u8840\u91CF\u4F4E\u4E8E\u6700\u5927\u751F\u547D\u503C\u768420%\u65F6\uFF0C\u83B7\u5F97\u8840\n\u91CF\u7B49\u540C\u4E8E\u201C\u50B2\u6162\u504F\u89C1\u4E4B\u7FBD\u201D50%\u5E76\u6301\u7EED17s\u7684\u62A4\u76FE\uFF0C\u6BCF40s\u89E6\u53D1\n1\u6B21\n\n\u5361\u724C\uFF1A\n\u8BEF\u89E3   
    \u6210\u89C1    \u5012\u65BD    \u7F6A\u4EBA    \u50B2\u6162    \u504F\u89C1   
    \u54C0\u4F24    \u5FE7\u90C1"
