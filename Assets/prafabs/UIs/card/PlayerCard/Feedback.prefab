    - target: {fileID: 8308702727041960155, guid: 350700635b044014fadf42800ddd9d84, type: 3}
      propertyPath: backGroundStory
      value: "\u201C\u9EBB\u6728\u201D\uFF1A\u5728\u6709\u7FBD\u89E3\u9501\u7684\u6761\u4EF6\u4E0B\uFF0C\u7ACB\u5373\u56DE\n\u590D\u603B\u8840\u91CF\u76845%\uFF0C\u63D0\u9AD8\u603B\u8840\u91CF5%\u7684\u8840\u91CF\n\u4E0A\u9650\uFF0C\u73A9\u5BB6\u548C\u654C\u4EBA\u901A\u7528\n\u201C\u575A\u97E7\u201D\uFF1A\u4F7F\u5BF9\u8C61\u589E\u52A010%\u7684\u97E7\u6027\uFF0C\u6700\u9AD8\n\u4E0D\u8D85\u8FC720\u70B9\u97E7\u6027\uFF0C\u6301\u7EED16s\n\u201C\u795E\u901F\u201D\uFF1A\u4F7F\u5BF9\u8C61\u52A010%\u901F\u5EA6\uFF0C\u6301\u7EED16s\n\u201C\u51DD\u91CD\u201D\uFF1A\u4F7F\u5BF9\u8C61\u964D\u4F4E10%\u8D77\u8DF3\u901F\u5EA6\uFF0C\u6301\n\u7EED16s\n\u201C\u5F02\u5E38\u8106\u5F31\u201D\uFF1A\u4F7F\u5BF9\u8C61\u964D\u4F4E10%\u7684\u5F02\u5E38\u6297\u6027\n\uFF0C\u6301\u7EED16s\n\u201C\u707C\u4F24\u8106\u5F31\u201D\uFF1A\u4F7F\u5BF9\u8C61\u964D\u4F4E1\u70B9\u707C\u4F24\u62B5\u6297\uFF0C\n\u6301\u7EED16s\n\u201C\u4F24\u75D5\u62B5\u6297\u201D\uFF1A\u4F7F\u5BF9\u8C61\u63D0\u9AD81\u70B9\u4F24\u75D5\u6297\u6027\uFF0C\n\u6301\u7EED16s"
      objectReference: {fileID: 0}
