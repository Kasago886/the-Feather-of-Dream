  - name: "\u6E34\u6C42\u8BA4\u53EF"
    description: "\u5F53Boss2\u9636\u6BB5\u5931\u53BB\u4E00\u5B9A\u91CF\n\u7684\u8840\u91CF\u65F6\uFF0C\"\u51E1\u5EB8\"\u6309\u4E00\u5B9A\n\u6BD4\u4F8B\u8F6C\u5316\u4E3A\"\u6E34\u6C42\u8BA4\u53EF\"\uFF0C\n\u6BCF\u6B21\u53D7\u51FB\u6263\u96640.5\u6EF4\u8840\uFF0C\n\u6301\u7EED\u65F6\u95F4\u65E0\u9650"
    buffPrefab: {fileID: 6051908474743900384, guid: f6915ba31a508b6468686c446e9e42af, type: 3}
  - name: "\u4FEE\u8865\u7A7A\u865A"
    description: "\u7ACB\u5373\u6263\u96642.5%\u5355\u4E2A\u89E3\u9501\u7FBD\n\u7684\u8840\u91CF\uFF0C\u6BCF2\u79D2\u589E\u52A01\u5C42\u529B\n\u91CF\uFF0Cbuff\u6301\u7EED6\u79D2\uFF0C6\u79D2\u5185\n\u5982\u82E5\u5355\u4E2A\u89E3\u9501\u7FBD\u53D7\u5230\u8D85\u8FC7\n20\u70B9\u751F\u547D\u503C\uFF0C\u5219\u5168\u4F53\u5355\u4E2A\n\u89E3\u9501\u7FBD\u4E00\u5171\u6263\u966440\u70B9\u751F\u547D\n\u503C"
    buffPrefab: {fileID: 6051908474743900384, guid: 7707632943431624198d379db0484ece, type: 3}
  - name: "\u60CA\u60F6"
    description: "\u5728\u6709\u7FBD\u89E3\u9501\u7684\u6761\u4EF6\u4E0B\uFF0C\n\u7ACB\u5373\u53D7\u52301\u70B9\u4F24\u5BB3\uFF0C\u5E76\n\u56DE\u590D1\u6EF4\u8840\uFF0C\u73A9\u5BB6\u548C\u654C\n\u4EBA\u901A\u7528"
